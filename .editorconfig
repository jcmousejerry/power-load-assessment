root = true

[*.java]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
max_line_length = 120
trim_trailing_whitespace = true

[*.{xml,yml,yaml,json,js,jsx,ts,tsx,css,md,sql,py,ps1}]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
